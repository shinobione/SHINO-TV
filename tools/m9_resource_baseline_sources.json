{
  "environments": {
    "env:esp12e": {
      "board": "esp12e",
      "board_build.filesystem": "littlefs",
      "board_build.flash_mode": "dio",
      "board_build.flash_size": "4MB",
      "board_build.ldscript": "eagle.flash.4m3m.ld",
      "build_flags": "\n-Iinclude\n-DPIO_FRAMEWORK_ARDUINO_LWIP2_LOW_MEMORY_LOW_FLASH",
      "check_flags": "\nclangtidy: --checks=-*,bugprone-*,modernize-*,readability-*,modernize-use-trailing-return-type,-bugprone-easily-swappable-parameters --warnings-as-errors=*",
      "check_tool": "clangtidy",
      "extra_scripts": "pre:scripts/git_version.py",
      "framework": "arduino",
      "lib_deps": "\nbblanchon/ArduinoJson@7.4.3\nmoononournation/GFX Library for Arduino@^1.6.4\nbitbank2/AnimatedGIF@^2.2.0",
      "monitor_filters": "esp8266_exception_decoder, time, colorize",
      "monitor_speed": "115200",
      "platform": "espressif8266@4.2.1",
      "platform_packages": "\nplatformio/framework-arduinoespressif8266@3.30102.0",
      "upload_speed": "921600"
    },
    "env:esp12e_m9_4m2m": {
      "board_build.ldscript": "eagle.flash.4m2m.ld",
      "extends": "env:esp12e"
    },
    "env:esp12e_m9_4m2m_mount_probe": {
      "board_build.filesystem": "littlefs",
      "board_build.ldscript": "eagle.flash.4m2m.ld",
      "build_flags": "\n${env:esp12e.build_flags}\n-DSHINO_BOOT_PROFILE=2\n-DSHINO_M9_MOUNT_PROBE=1\n-fstack-usage",
      "extends": "env:esp12e_m9_4m2m",
      "extra_scripts": "\n${env:esp12e.extra_scripts}\npre:scripts/m9_mount_probe_gate.py"
    },
    "platformio": {
      "default_envs": "esp12e"
    }
  },
